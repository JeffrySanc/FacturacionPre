<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2008/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <Body>
    <ReportItems>
      <Textbox Name="TituloReporte">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>REPORTE DE FACTURA</Value>
                <Style>
                  <FontSize>18pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                </Style>
              </TextRun>
            </TextRuns>
            <Style>
              <TextAlign>Center</TextAlign>
            </Style>
          </Paragraph>
        </Paragraphs>
        <rd:DefaultName>TituloReporte</rd:DefaultName>
        <Top>0cm</Top>
        <Left>0cm</Left>
        <Height>1.2cm</Height>
        <Width>17cm</Width>
        <Style>
          <Border>
            <Style>None</Style>
          </Border>
        </Style>
      </Textbox>
      <Rectangle Name="RectEncabezado">
        <ReportItems>
          <Textbox Name="TxtNoFactura">
            <CanGrow>true</CanGrow>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>= "Factura No.: " &amp; First(Fields!NUMFAC.Value, "Encabezado")</Value>
                    <Style>
                      <FontSize>12pt</FontSize>
                      <FontWeight>Bold</FontWeight>
                    </Style>
                  </TextRun>
                </TextRuns>
              </Paragraph>
            </Paragraphs>
            <rd:DefaultName>TxtNoFactura</rd:DefaultName>
            <Top>0.2cm</Top>
            <Left>0.2cm</Left>
            <Height>0.7cm</Height>
            <Width>5cm</Width>
            <Style />
          </Textbox>
          <Textbox Name="TxtFecha">
            <CanGrow>true</CanGrow>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>= "Fecha: " &amp; Format(First(Fields!FECFAC.Value, "Encabezado"), "dd/MM/yyyy hh:mm tt")</Value>
                    <Style>
                      <FontSize>10pt</FontSize>
                    </Style>
                  </TextRun>
                </TextRuns>
              </Paragraph>
            </Paragraphs>
            <rd:DefaultName>TxtFecha</rd:DefaultName>
            <Top>0.2cm</Top>
            <Left>5.5cm</Left>
            <Height>0.7cm</Height>
            <Width>6cm</Width>
            <Style />
          </Textbox>
          <Textbox Name="TxtUsuario">
            <CanGrow>true</CanGrow>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>= "Usuario: " &amp; Parameters!Usuario.Value</Value>
                    <Style>
                      <FontSize>10pt</FontSize>
                    </Style>
                  </TextRun>
                </TextRuns>
              </Paragraph>
            </Paragraphs>
            <rd:DefaultName>TxtUsuario</rd:DefaultName>
            <Top>0.2cm</Top>
            <Left>12cm</Left>
            <Height>0.7cm</Height>
            <Width>5cm</Width>
            <Style />
          </Textbox>
          <Textbox Name="TxtCliente">
            <CanGrow>true</CanGrow>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>= "Cliente: " &amp; First(Fields!CODCLI.Value, "Encabezado") &amp; " - " &amp; First(Fields!NOMCLI.Value, "Encabezado") &amp; " " &amp; First(Fields!APECLI.Value, "Encabezado")</Value>
                    <Style>
                      <FontSize>10pt</FontSize>
                    </Style>
                  </TextRun>
                </TextRuns>
              </Paragraph>
            </Paragraphs>
            <rd:DefaultName>TxtCliente</rd:DefaultName>
            <Top>1.1cm</Top>
            <Left>0.2cm</Left>
            <Height>0.7cm</Height>
            <Width>10cm</Width>
            <Style />
          </Textbox>
          <Textbox Name="TxtDireccion">
            <CanGrow>true</CanGrow>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>= "Dirección: " &amp; First(Fields!DIRCLI.Value, "Encabezado")</Value>
                    <Style>
                      <FontSize>10pt</FontSize>
                    </Style>
                  </TextRun>
                </TextRuns>
              </Paragraph>
            </Paragraphs>
            <rd:DefaultName>TxtDireccion</rd:DefaultName>
            <Top>1.1cm</Top>
            <Left>10.5cm</Left>
            <Height>0.7cm</Height>
            <Width>6.5cm</Width>
            <Style />
          </Textbox>
          <Textbox Name="TxtTelefono">
            <CanGrow>true</CanGrow>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>= "Teléfono: " &amp; First(Fields!TELCLI.Value, "Encabezado")</Value>
                    <Style>
                      <FontSize>10pt</FontSize>
                    </Style>
                  </TextRun>
                </TextRuns>
              </Paragraph>
            </Paragraphs>
            <rd:DefaultName>TxtTelefono</rd:DefaultName>
            <Top>1.9cm</Top>
            <Left>0.2cm</Left>
            <Height>0.6cm</Height>
            <Width>8cm</Width>
            <Style />
          </Textbox>
        </ReportItems>
        <Top>1.5cm</Top>
        <Left>0cm</Left>
        <Height>2.8cm</Height>
        <Width>17cm</Width>
        <Style>
          <Border>
            <Style>Solid</Style>
            <Color>SteelBlue</Color>
          </Border>
        </Style>
